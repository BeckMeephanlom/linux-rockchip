/dts-v1/;
/plugin/;

/ {

	fragment@0 {
		target = <&csi2_dphy0_hw>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target = <&csi2_dphy0>;

		__overlay__ {
			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					mipidphy0_in_ucam0: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&imx415_1_out1>;
						data-lanes = <1 2 3 4>;
					};
				};

				port@1 {
					reg = <1>;

					csidphy0_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&mipi2_csi2_input>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&i2c4>;

		__overlay__ {
			status = "okay";

			imx415_1: imx415@37 {
				status = "okay";
				compatible = "sony,imx415";
				reg = <0x37>;

				clocks = <&cru CLK_MIPI_CAMARAOUT_M1>;
				clock-names = "xvclk";

				assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M1>;
				assigned-clock-rates = <24000000>;

				power-domains = <&power RK3588_PD_VI>;

				pwdn-gpios = <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>;

				rockchip,camera-module-index = <0>;
				rockchip,camera-module-facing = "back";
				rockchip,camera-module-name = "WaveShare-IMX415";
				rockchip,camera-module-lens-name = "default";

				port {
					imx415_1_out1: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2 3 4>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&mipi2_csi2>;

		__overlay__ {
			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					mipi2_csi2_input: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&csidphy0_out>;
					};
				};

				port@1 {
					reg = <1>;

					mipi2_csi2_output: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&cif_mipi_in2>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&rkcif_mipi_lvds2>;

		__overlay__ {
			status = "okay";

			port {
				cif_mipi_in2: endpoint {
					remote-endpoint = <&mipi2_csi2_output>;
				};
			};
		};
	};

	fragment@5 {
		target = <&rkcif_mipi_lvds2_sditf>;

		__overlay__ {
			status = "okay";

			port {
				mipi2_lvds_sditf: endpoint {
					remote-endpoint = <&isp0_vir0_in>;
				};
			};
		};
	};

	fragment@6 {
		target = <&rkisp0_vir0>;

		__overlay__ {
			status = "okay";

			port {
				#address-cells = <1>;
				#size-cells = <0>;

				isp0_vir0_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&mipi2_lvds_sditf>;
				};
			};
		};
	};

	fragment@7 {
		target = <&rkcif>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&rkcif_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <&rkisp0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@10 {
		target = <&isp0_mmu>;

		__overlay__ {
			status = "okay";
		};
	};
};
